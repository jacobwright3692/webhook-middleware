{
  "name": "webhook-middleware-agent",
  "version": "1.0.0",
  "description": "Backend webhook intake service for normalizing lead payloads and forwarding them to a CRM webhook.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "cleanup:speed-script": "node scripts/cleanup-speed-to-lead-notes.js --dry-run",
    "notes:remediate:preview": "node scripts/remediate-crm-notes.js",
    "intake:queue:inspect": "node scripts/intake-queue.js inspect",
    "intake:queue:dedupe": "node scripts/intake-queue.js dedupe"
  },
  "keywords": [
    "webhook",
    "express",
    "middleware",
    "crm",
    "leads"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  }
}
